	(text "Input: dual lab supply, reverse-polarity protection"
		(exclude_from_sim no)
		(at 35.306 30.48 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9b19bde6-dd72-5577-aedf-19134df474e3")
	)
	(text "Bench supply note: J5 is set slightly above 5 V so that +5VA (TP3) reads 5.0 V to 5.2 V after the B5819W drop\n(about 0.3 V to 0.45 V) and R18. Below 5.0 V the DAC80508 internal 2.5 V reference exceeds VDD/2 and trips the\nreference alarm (all DAC outputs 0 V). Do not let +5VA exceed 5.5 V (DAC80508, TMUX1109).\nPower-up order: J4 (+/-15 V, TMUX6136) on first, then J5 (+/-5 V). Power-down in the reverse order."
		(exclude_from_sim no)
		(at 35.56 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4f6a2c1e-8b3d-4e57-9a10-2b7c5d8e9f31")
	)
