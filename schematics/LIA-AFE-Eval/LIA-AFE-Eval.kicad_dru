(version 1)
# LIA-AFE-Eval custom DRC rules.
# Fab target: JLCPCB 4-layer, 1.6 mm, JLC04161H-7628, 1 oz outer / 0.5 oz inner,
# HASL, no-surcharge limits (vias >= 0.30 mm hole / 0.45 mm pad, trace/space >= 0.09 mm).
# Board-wide minimums and net classes are in Board Setup (LIA-AFE-Eval.kicad_pro).

# --- JLCPCB fabrication limits ---------------------------------------------

(rule "JLC: PTH pad annular ring"
	(condition "A.Type == 'Pad' && A.isPlated()")
	(constraint annular_width (min 0.15)))

(rule "JLC: NPTH minimum hole"
	(condition "A.Type == 'Pad' && !A.isPlated()")
	(constraint hole_size (min 0.5)))

(rule "JLC: via drill no-surcharge"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.3))
	(constraint via_diameter (min 0.45)))

(rule "JLC: pad-hole to pad-hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.5)))

# --- Planes and board edge ---------------------------------------------------

(rule "Zones: pull back from board edge"
	(condition "A.Type == 'Zone'")
	(constraint edge_clearance (min 0.5)))

# --- Mounting holes (M3 screw head 5.5 mm dia) --------------------------------
# Keep copper on the outer layers outside the screw head, so a metal screw or
# standoff does not touch any net.

(rule "Mounting holes: copper keep-out on outer layers"
	(layer outer)
	(condition "A.memberOfFootprint('H*')")
	(constraint hole_clearance (min 1.3)))

# --- Analog ------------------------------------------------------------------
# High-impedance sensor nodes (drain, gate, pixel drain, INA inputs, DAC reference)
# keep extra distance from supply rails. GND is excluded so guard rings and
# ground pours can surround them.

(rule "Analog_Sensitive to supply rails"
	(condition "A.NetClass == 'Analog_Sensitive' && B.NetClass == 'Power' && B.NetName != 'GND'")
	(constraint clearance (min 0.5)))

(rule "Analog_Sensitive to digital"
	(condition "A.NetClass == 'Analog_Sensitive' && B.NetClass == 'Digital'")
	(constraint clearance (min 0.5)))
